---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-rule" />
  <div class="container inner">
    <div class="left">
      <span class="mono dim">© {year} nick</span>
      <span class="jp dim small">手作り</span>
    </div>
    <div class="links">
      <a href="https://github.com/electronick-co" target="_blank" rel="noopener" class="mono dim">github</a>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  .footer-rule {
    height: 1px;
    background: var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    padding-bottom: 1.5rem;
    gap: 1rem;
  }

  .left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .small {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .links a {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .links a:hover { opacity: 1; }
</style>
