---
interface Props {
  title: string;
  description: string;
  slug: string;
  tags?: string[];
  image?: string;
  status?: 'ongoing' | 'completed';
  date: Date;
}

const { title, description, slug, tags = [], image, status, date } = Astro.props;

const year = date.getFullYear();
---

<a href={`/projects/${slug}`} class="card">
  <div class="thumb">
    {image
      ? <img src={image} alt={title} loading="lazy" />
      : <div class="placeholder"><span class="jp">制作</span></div>
    }
  </div>

  <div class="body">
    <div class="meta mono dim">
      <span>{year}</span>
      {status === 'ongoing' && <span class="status coral">● 進行中</span>}
    </div>
    <h3 class="title">{title}</h3>
    <p class="desc">{description}</p>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map(t => <span class="tag">{t}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
    background: var(--bg);
  }

  .card:hover {
    border-color: var(--text-dim);
    transform: translateY(-2px);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .thumb img { transform: scale(1.03); }

  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--line);
    font-size: 2rem;
  }

  .body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.15rem;
  }

  .status {
    font-family: var(--font-jp);
    font-size: 0.65rem;
    color: var(--coral);
    letter-spacing: 0.04em;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .desc {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.55;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
</style>
